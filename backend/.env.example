# 复制本文件为 .env 后按需修改（.env 已被 gitignore，不会提交）

# 运行环境：dev / prod
APP_ENV=dev

# 固定测试邀请码默认关闭；仅本地临时体验时改为 true，生产环境保持 false
SEED_TEST_INVITE_CODES=false

# SQLite 数据库地址（相对路径以 backend/ 为基准）
DATABASE_URL=sqlite:///data/weilan.db

# 定时采集间隔（分钟）
COLLECT_INTERVAL_MINUTES=45

# 单源采集超时（秒）
COLLECT_TIMEOUT_SECONDS=20

# ---- SQLite 云端备份（生产环境使用，本地开发可全部留空）----
# 五项必须同时配置。TOS_DATABASE_OBJECT_KEY 使用固定对象名，桶的版本控制保留历史版本。
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_BUCKET=
TOS_ENDPOINT=
TOS_REGION=
TOS_DATABASE_OBJECT_KEY=database/weilan.db
TOS_BACKUP_INTERVAL_MINUTES=5
TOS_REQUEST_TIMEOUT_SECONDS=20

# ---- 大模型（OpenAI 兼容接口）----
# 留空则进入 mock 模式（开发/界面验收可用），真实验收前填入
MODEL_API_KEY=

# DeepSeek 官方；换成火山方舟时改这里
MODEL_BASE_URL=https://api.deepseek.com

MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# ---- 运营者鉴权（质检页口令，上线前必须改成强口令）----
OPERATOR_KEY=weilan-local-dev
