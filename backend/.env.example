# 复制本文件为 .env 后按需修改（.env 已被 gitignore，不会提交）

# 运行环境：dev / prod
APP_ENV=dev

# SQLite 数据库地址（相对路径以 backend/ 为基准）
DATABASE_URL=sqlite:///data/weilan.db

# 定时采集间隔（分钟）
COLLECT_INTERVAL_MINUTES=45

# 单源采集超时（秒）
COLLECT_TIMEOUT_SECONDS=20

# ---- 大模型（OpenAI 兼容接口）----
# 留空则进入 mock 模式（开发/界面验收可用），真实验收前填入
MODEL_API_KEY=

# DeepSeek 官方；换成火山方舟时改这里
MODEL_BASE_URL=https://api.deepseek.com

MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
